{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "describe"
        }
      },
      "required": [
        "method"
      ]
    },
    {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "diagnose"
        }
      },
      "required": [
        "method"
      ]
    },
    {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "resolve"
        },
        "params": {
          "type": "object",
          "properties": {
            "process": {
              "$ref": "#/$defs/ProcessIdentity"
            }
          },
          "required": [
            "process"
          ]
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "activate"
        },
        "params": {
          "type": "object",
          "properties": {
            "process": {
              "$ref": "#/$defs/ProcessIdentity"
            },
            "target_id": {
              "type": "string"
            }
          },
          "required": [
            "process",
            "target_id"
          ]
        }
      },
      "required": [
        "method",
        "params"
      ]
    }
  ],
  "required": [
    "version",
    "id"
  ],
  "$defs": {
    "ProcessIdentity": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "format": "int32"
        },
        "start_ticks": {
          "description": "Linux /proc/PID/stat starttime, in clock ticks since boot.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "pid",
        "start_ticks"
      ]
    }
  }
}
